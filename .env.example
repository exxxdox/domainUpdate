# 复制成 .env 后填写。.env 已在 .gitignore 与 .dockerignore 里，不会被提交，也不会进镜像。
# docker compose 会用这里的值做 ${...} 插值；sh script.sh run 也读同一个文件。

# Web 监听端口。host 网络下这就是宿主端口。
WEB_PORT=8501

# 日志级别，可选 DEBUG / INFO / WARNING / ERROR。不写就是 INFO。
# 排障时改成 DEBUG，容器日志会多出请求细节。
# DOMAIN_UPDATE_LOG_LEVEL=INFO

# 控制台登录凭据。两项都要填：只填一项会被当成配置错误，服务拒绝启动；
# 两项都留空才是「明确不启用登录」，此时服务照常启动但完全不校验登录。
# 不提供注册入口，也没有找回密码：改这两个值后重启容器即生效，
# 同时所有已签发的登录状态立即失效（会话密钥由凭据派生）。
#
# 公网部署务必再套一层带 HTTPS 的反向代理：服务本身是明文 HTTP，
# 会话 Cookie 不带 Secure，加密与传输层保护只能由反代提供。
WEB_USERNAME=
WEB_PASSWORD=
